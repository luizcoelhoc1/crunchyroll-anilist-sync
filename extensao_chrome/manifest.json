{
  "manifest_version": 3,
  "name": "Crunchyroll → AniList — conexão local",
  "version": "1.1.0",
  "description": "Entrega acessos temporários ao sincronizador Python local, somente após iniciar a conexão.",
  "minimum_chrome_version": "111",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://anilist.co/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}